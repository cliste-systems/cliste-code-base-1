# Copy to `.env.local` and fill in values for local dev.
# Production values live in Vercel project settings.

# Supabase (required for auth, dashboard, admin console)
NEXT_PUBLIC_SUPABASE_URL=https://rtoebbwzwxcnscsxghww.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin console password gate (/admin/login)
CLISTE_ADMIN_SECRET=choose_a_strong_local_password

# Production edge auth (Cloudflare Transform Rule → x-cliste-edge header)
CLISTE_EDGE_SHARED_SECRET=generate_a_long_random_secret

# Auth brute-force counters (Postgres-backed; never reuse across environments)
AUTH_RATE_LIMIT_SALT=generate_a_long_random_salt

# Support impersonation banner cookie signing
CLISTE_SUPPORT_DASHBOARD_SECRET=generate_a_long_random_secret

# Block destructive scripts against production unless explicitly overridden
# CLISTE_PRODUCTION_SUPABASE_REF=rtoebbwzwxcnscsxghww
# CLISTE_ALLOW_DESTRUCTIVE_ON_PROD=1

# Optional: Supabase Management API token for scripts/patch-supabase-auth-urls.ts
# SUPABASE_ACCESS_TOKEN=
